# Opus API configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Confirm the correct host for your Opus environment — see the API reference, section 2.
OPUS_BASE_URL=https://operator.opus.com

# Server-side only. Create via POST /api-keys in the Opus dashboard.
# NEVER expose this to the browser or commit it to source control.
OPUS_SERVICE_KEY=your_opus_service_key_here

# Workspace files are uploaded into (used by /job/file/upload's accessScope=workspace).
OPUS_WORKSPACE_ID=your_workspace_id_here

# Banking - KYC workflow.
OPUS_WORKFLOW_ID=862c7f7c-302a-4e96-9985-ab8e41cd007b

# /job/execute requires callbackUrl to be a real URL (an empty string 400s).
# We poll for status instead of using the callback, so this URL is never
# actually called - the placeholder below just needs to pass validation.
OPUS_CALLBACK_URL=https://example.com/opus-callback

# --- Input node variable name overrides -------------------------------------
# The four defaults baked into server.js are the exact Input node variable
# names for this workflow (workflow_input_6o3r11awf etc.) - only set these if
# they ever change on the Opus side.
# OPUS_INPUT_ID_DOCUMENT=workflow_input_6o3r11awf
# OPUS_INPUT_PROOF_OF_ADDRESS=workflow_input_efxj86krs
# OPUS_INPUT_APPLICATION_FORM_JSON=workflow_input_izxwtowwa
# OPUS_INPUT_SCREENING_POLICY=workflow_input_x9wtpmxp3

PORT=3000
